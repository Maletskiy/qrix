{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "qr-ix.ru" }],
      "destination": "https://qr-ix.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.qr-ix.ru" }],
      "destination": "https://qr-ix.com/$1",
      "permanent": true
    }
  ]
}
