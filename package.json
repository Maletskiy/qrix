{
  "name": "qrix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:pages",
    "preview": "vite preview",
    "verify": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=scripts/verify.mjs --external:@resvg/resvg-js --external:jsqr --external:pngjs --log-level=error && node scripts/verify.mjs",
    "deploy": "env -u npm_config_cache npx --yes vercel --global-config ./.vercel-cli --prod --yes",
    "build:pages": "esbuild scripts/build-pages.ts --bundle --platform=node --format=esm --outfile=scripts/build-pages.mjs --external:@resvg/resvg-js --external:wawoff2 --external:opentype.js --log-level=error && node scripts/build-pages.mjs",
    "check:pages": "esbuild scripts/check-pages.ts --bundle --platform=node --format=esm --outfile=scripts/check-pages.mjs --external:@resvg/resvg-js --external:jsqr --external:pngjs --log-level=error && node scripts/check-pages.mjs"
  },
  "dependencies": {
    "motion": "^14.3.0",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cryptocurrency-icons": "^0.18.1",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "simple-icons": "^16.35.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wawoff2": "^2.0.1"
  }
}
