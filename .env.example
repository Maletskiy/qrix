# Аналитика Qrix (Umami).
# Обычно этот файл не нужен: ID сайта уже вписан в src/lib/analytics.ts,
# и сборка работает без настройки. Переменные ниже — только для перекрытия.

# Другой сайт, стенд или свой инстанс. Значение `off` выключает аналитику.
VITE_UMAMI_SITE_ID=

# Свой инстанс Umami вместо облака, без завершающего слэша.
# Пусто — используется https://cloud.umami.is
VITE_UMAMI_HOST=

# «1» — считать события и в npm run dev. По умолчанию выключено,
# чтобы разработка не попадала в статистику.
VITE_ANALYTICS_DEV=
