# Аналитика Qrix (Umami).
# Обычно этот файл не нужен: ID сайта уже вписан в src/lib/analytics.ts,
# и сборка работает без настройки. Переменные ниже — только для перекрытия.

# Другой сайт, стенд или свой инстанс. Значение `off` выключает аналитику.
VITE_UMAMI_SITE_ID=

# Свой инстанс Umami вместо облака, без завершающего слэша.
# Пусто — используется https://cloud.umami.is
VITE_UMAMI_HOST=

# «1» — считать события и в npm run dev. По умолчанию выключено,
# чтобы разработка не попадала в статистику.
VITE_ANALYTICS_DEV=

# ── Динамические QR (серверная часть) ────────────────────────────────────
# Где хранить коды: Upstash Redis по REST (прод) либо файл (локально).
# Upstash Redis — хранилище динамических кодов в проде.
# Без этих переменных работает файловый режим: удобно локально, но на
# serverless данные не переживают запрос, потому что у каждой функции свой /tmp.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Исторические имена этого проекта: читаются, если UPSTASH_* не заданы.
QR_DB_URL=
QR_DB_TOKEN=

QR_DB_FILE=.qrix/dynamic.json

# Секрет для подписи лицензий. Без него платный режим выключен,
# лимит остаётся 3 кода.
QR_LICENSE_SECRET=

# Соль для хеша IP сканирующего: сам адрес не хранится никогда.
QR_IP_SALT=

# Публичный адрес сайта — из него собирается короткая ссылка.
QR_BASE_URL=https://qr-ix.com
